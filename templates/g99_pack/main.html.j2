{#-
  main.html.j2 — Princeps G99 Application Pack (ENA EREC G99 Issue 2).
  Rendered by utils.g99_pack_generator.generate_g99_pack().
  Produces a full A4-portrait pack (Sections A–H + Annex C where applicable)
  targetted at DNO assessment engineers (UKPN / SSEN / NGED / SPEN / NPG /
  ENWL).

  Context keys (all required):
    form          — structured form_data (meta + section_a..h, annex_c_storage)
    meta          — convenience alias for form.meta
    css           — rendered CSS string
    sld_svg       — SLD SVG markup (from utils.sld_generator.generate_sld)
    lvrt_svg      — LVRT chart SVG (rendered from _lvrt_curve.svg.j2)
    hvrt_svg      — HVRT chart SVG (rendered from _hvrt_curve.svg.j2)
-#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>G99 Application Pack — {{ form.section_a_applicant.site.name }}</title>
  <style>{{ css | safe }}</style>
</head>
<body class="princeps-root">

{# ============================================================== #}
{# COVER                                                         #}
{# ============================================================== #}
<section class="cover">
  <div class="cover-strip"></div>
  <h1>G99 APPLICATION PACK</h1>
  <p class="cover-sub">
    {{ meta.ena_reference }}<br/>
    {{ meta.application_type }} — Category {{ meta.ena_category }} —
    {{ meta.g99_type }}
  </p>
  <table class="cover-meta">
    <tr><td class="lbl">Site</td><td>{{ form.section_a_applicant.site.name }}</td></tr>
    <tr><td class="lbl">Applicant</td>
        <td>{{ field(form.section_a_applicant.applicant.company) }}</td></tr>
    <tr><td class="lbl">DNO licence area</td>
        <td>{{ field(form.section_a_applicant.connection.dno_licence_area) }}</td></tr>
    <tr><td class="lbl">Proposed capacity</td>
        <td>{{ form.section_b_units.totals.export_mw }} MW (export) —
            <span class="prov">[Princeps v{{ meta.princeps_version }}]</span></td></tr>
    <tr><td class="lbl">Proposed voltage</td>
        <td>{{ form.section_a_applicant.connection.proposed_voltage_kv }} kV</td></tr>
    <tr><td class="lbl">G99 Type</td>
        <td>{{ meta.g99_type }}</td></tr>
    <tr><td class="lbl">Document reference</td>
        <td>{{ meta.doc_ref }}</td></tr>
    <tr><td class="lbl">Generated</td>
        <td>{{ meta.generated_at[:10] }} by {{ meta.generated_by }}</td></tr>
  </table>

  <div class="attestation">
    <strong>Attestation</strong><br/>
    {% for line in meta.attestation_lines %}
      &bull; {{ line }}<br/>
    {% endfor %}
  </div>

  <div class="disclaimer">
    {{ meta.disclaimer }}<br/>
    <span class="note">Data provenance: <strong>{{ meta.provenance }}</strong></span>
  </div>

  {% if form.princeps_assessment.verdict %}
  <div class="verdict-block">
    <span class="verdict" style="background: {{ meta.verdict_color }};">
      {{ form.princeps_assessment.verdict }}
    </span>
    <span class="note">Princeps confidence:
      {{ form.princeps_assessment.confidence_pct }}%</span>
    <p class="note">{{ form.princeps_assessment.summary }}</p>
  </div>
  {% endif %}
</section>

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION A — Applicant, Site and Proposed Connection          #}
{# ============================================================== #}
{% include "g99_pack/_section_a_applicant.html.j2" with context %}

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION B — Generating Plant / Energy Storage Unit Data       #}
{# ============================================================== #}
{% set section_b = form.section_b_units %}
{% include "g99_pack/_section_b_units.html.j2" with context %}

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION C — Interface Protection                              #}
{# ============================================================== #}
{% set section_c = form.section_c_protection %}
{% include "g99_pack/_section_c_protection.html.j2" with context %}

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION D — Control, Monitoring and SCADA                     #}
{# ============================================================== #}
{% set section_d = form.section_d_scada %}
{% include "g99_pack/_section_d_scada.html.j2" with context %}

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION E — Single Line Diagram                               #}
{# ============================================================== #}
<section class="g99-section section-e">
  <h2>Section E &mdash; Single Line Diagram</h2>
  <p class="section-lead">
    Single line diagram per <em>G99 Issue 2 Clause 5.3</em> — incomer,
    switchgear, protection, CT/VT, isolator, earth switch, each generating
    unit with protection and rated capacity, auxiliaries (auxiliary
    transformer, auxiliary switchboard, UPS), and metering point
    (Elexon-approved CT class 0.5S).
  </p>
  <div class="sld-frame">
    {{ sld_svg | safe }}
  </div>
  <table class="form">
    <tr><td class="lbl">Incomer switchgear rating</td>
        <td>{{ field(form.section_e_sld.incomer_switchgear) }}</td></tr>
    <tr><td class="lbl">CT / VT location</td>
        <td>{{ field(form.section_e_sld.ct_vt_location) }}</td></tr>
    <tr><td class="lbl">Isolator / earth switch make</td>
        <td>{{ field(form.section_e_sld.isolator_earth_switch) }}</td></tr>
    <tr><td class="lbl">Auxiliary transformer rating</td>
        <td>{{ field(form.section_e_sld.aux_transformer) }}</td></tr>
    <tr><td class="lbl">UPS rating / autonomy</td>
        <td>{{ field(form.section_e_sld.ups) }}</td></tr>
    <tr><td class="lbl">Revenue metering CT class</td>
        <td>{{ field(form.section_e_sld.metering_ct_class) }}</td></tr>
  </table>

  {% if form.section_e_sld.cable_schedule %}
  <h3>E1. Auto-generated cable schedule</h3>
  <table class="set">
    <tr>
      <th>Segment</th><th>Voltage</th><th>Current (A)</th>
      <th>Cable (mm²)</th><th>Type</th>
    </tr>
    {% for c in form.section_e_sld.cable_schedule %}
    <tr>
      <td>{{ c.segment }}</td>
      <td>{{ c.voltage }}</td>
      <td>{{ c.current_a }}</td>
      <td>{{ c.cable_mm2 }}</td>
      <td>{{ c.type }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
</section>

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION F — Harmonic + flicker assessment                    #}
{# ============================================================== #}
{% set section_f = form.section_f_harmonics %}
{% include "g99_pack/_section_f_harmonics.html.j2" with context %}

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION G — Commissioning Plan and Witness Points            #}
{# ============================================================== #}
{% set section_g = form.section_g_commissioning %}
{% include "g99_pack/_section_g_commissioning.html.j2" with context %}

<div class="page-break"></div>

{# ============================================================== #}
{# SECTION H — Site-Specific Conditions                          #}
{# ============================================================== #}
<section class="g99-section section-h">
  <h2>Section H &mdash; Site-Specific Conditions</h2>
  <p class="section-lead">
    Site-specific derogations, anti-islanding special provisions, reactive
    power scheduling mode, and voltage-rise analysis for weak networks
    (radial 33 / 11 kV feeders). <em>Clause 11 &amp; Annex D, G99 Issue 2.</em>
  </p>

  <h3>H1. Requested derogations</h3>
  {% if form.section_h_site_specific.derogations %}
  <table class="set">
    <tr><th>Ref</th><th>Clause</th><th>Derogation requested</th><th>Justification</th></tr>
    {% for d in form.section_h_site_specific.derogations %}
    <tr>
      <td>{{ d.ref }}</td>
      <td>{{ d.clause }}</td>
      <td>{{ d.request }}</td>
      <td>{{ d.justification }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="note">No derogations requested — generator will comply with all
    G99 Issue 2 default requirements.</p>
  {% endif %}

  <h3>H2. Anti-islanding special provisions</h3>
  <table class="form">
    <tr><td class="lbl">Additional passive backup</td>
        <td>{{ field(form.section_h_site_specific.anti_islanding_special.additional_passive) }}</td></tr>
    <tr><td class="lbl">Active detection (SMS / SFS)</td>
        <td>{{ field(form.section_h_site_specific.anti_islanding_special.active_detection) }}</td></tr>
    <tr><td class="lbl">Island agreement in place</td>
        <td>{{ field(form.section_h_site_specific.anti_islanding_special.island_agreement) }}</td></tr>
  </table>

  <h3>H3. Reactive power scheduling</h3>
  <table class="form">
    <tr><td class="lbl">Selected mode</td>
        <td>{{ field(form.section_h_site_specific.reactive_mode.selected_mode) }}</td></tr>
    <tr><td class="lbl">Voltage setpoint (generator-follows-voltage)</td>
        <td>{{ field(form.section_h_site_specific.reactive_mode.voltage_setpoint_pu) }} pu</td></tr>
    <tr><td class="lbl">Droop (%)</td>
        <td>{{ field(form.section_h_site_specific.reactive_mode.droop_pct) }}</td></tr>
    <tr><td class="lbl">Power factor setpoint (power-factor mode)</td>
        <td>{{ field(form.section_h_site_specific.reactive_mode.pf_setpoint) }}</td></tr>
  </table>

  <h3>H4. Voltage-rise analysis (weak-network feeders)</h3>
  <table class="form">
    <tr><td class="lbl">Short-circuit ratio at PoC (SCR)</td>
        <td>{{ field(form.section_h_site_specific.voltage_rise.scr) }}
          <span class="prov">[Princeps v{{ meta.princeps_version }}]</span></td></tr>
    <tr><td class="lbl">Network classification</td>
        <td>{{ field(form.section_h_site_specific.voltage_rise.network_classification) }}</td></tr>
    <tr><td class="lbl">Predicted voltage rise at Pmax (%Un)</td>
        <td>{{ field(form.section_h_site_specific.voltage_rise.rise_pct) }}%</td></tr>
    <tr><td class="lbl">Headroom against EREC P28 +3% step limit</td>
        <td>{{ field(form.section_h_site_specific.voltage_rise.headroom_pct) }}%</td></tr>
  </table>
</section>

{# ============================================================== #}
{# ANNEX C — Storage (where applicable, effective 2026-03-01)    #}
{# ============================================================== #}
{% if form.annex_c_storage %}
<div class="page-break"></div>
<section class="g99-section annex-c">
  <h2>Annex C &mdash; Storage-Specific Declarations (G99 Issue 2)</h2>
  <p class="section-lead">
    {{ form.annex_c_storage.applicability }}
    <em>Reference: {{ form.annex_c_storage.ena_reference }}.</em>
  </p>
  <h3>Annex C.1 — Nameplate</h3>
  <table class="form">
    {% for k, v in form.annex_c_storage.nameplate.items() %}
    <tr><td class="lbl">{{ k | replace('_',' ') | title }}</td><td>{{ field(v) }}</td></tr>
    {% endfor %}
  </table>
  <h3>Annex C.2 — Frequency response modes</h3>
  <table class="set">
    <tr><th>Mode</th><th>Capability (MW)</th><th>Response time</th><th>Status</th></tr>
    {% for key, mode in form.annex_c_storage.frequency_response_modes.items() if key != 'note' %}
    <tr>
      <td>{{ key | replace('_',' ') | title }}</td>
      <td>{{ field(mode.capability_mw) }}</td>
      <td>{{ mode.response_time_ms if mode.response_time_ms is defined else '—' }}</td>
      <td>{{ 'Declared' if mode.declared else 'Not declared' }}</td>
    </tr>
    {% endfor %}
  </table>
  <h3>Annex C.3 — Grid-forming declaration</h3>
  <table class="form">
    <tr><td class="lbl">Mode</td><td>{{ form.annex_c_storage.grid_forming_declaration.mode }}</td></tr>
    <tr><td class="lbl">Virtual inertia (MWs/MW)</td>
        <td>{{ field(form.annex_c_storage.anti_islanding_storage.virtual_inertia_mw_s_per_mw) }}</td></tr>
    <tr><td class="lbl">Black start capable</td>
        <td>{{ form.annex_c_storage.anti_islanding_storage.black_start_capable }}</td></tr>
    <tr><td class="lbl">Type-test evidence</td>
        <td>{{ field(form.annex_c_storage.grid_forming_declaration.compliance_evidence) }}</td></tr>
  </table>
</section>
{% endif %}

<div class="page-break"></div>

{# ============================================================== #}
{# SIGNATURE BLOCK                                                #}
{# ============================================================== #}
<section class="g99-section section-i">
  <h2>Signatures</h2>
  <p class="declaration">{{ form.section_i_signatures.declaration }}</p>
  <div class="sig-row">
    <div class="sig-cell">
      <div class="role">Applicant / signatory</div>
      <div class="sig-line"></div>
      <div class="note">Name: {{ field(form.section_i_signatures.applicant.printed_name) }}</div>
      <div class="note">Date: {{ field(form.section_i_signatures.applicant.date) }}</div>
    </div>
    <div class="sig-cell">
      <div class="role">Professional engineer reviewer</div>
      <div class="sig-line"></div>
      <div class="note">Name: {{ field(form.section_i_signatures.consulting_engineer.printed_name) }}</div>
      <div class="note">Institution: {{ field(form.section_i_signatures.consulting_engineer.institution) }}</div>
      <div class="note">Date: {{ field(form.section_i_signatures.consulting_engineer.date) }}</div>
    </div>
    <div class="sig-cell">
      <div class="role">Installer</div>
      <div class="sig-line"></div>
      <div class="note">Name: {{ field(form.section_i_signatures.installer.printed_name) }}</div>
      <div class="note">Accreditation: {{ field(form.section_i_signatures.installer.accreditation_body) }}</div>
      <div class="note">Date: {{ field(form.section_i_signatures.installer.date) }}</div>
    </div>
  </div>
</section>

<div class="page-break"></div>

{# ============================================================== #}
{# APPENDIX — Regulatory references                              #}
{# ============================================================== #}
<section class="g99-section appendix">
  <h2>Appendix &mdash; Applicable Regulatory References</h2>
  <p class="section-lead">
    Documents cited by clause number throughout this pack. DNO assessment
    engineer: please verify the effective editions below against your
    network's current compliance register before finalising the assessment.
  </p>
  <table class="set">
    <tr><th>Standard</th><th>Edition</th><th>Effective</th><th>Purpose</th></tr>
    <tr>
      <td>ENA EREC G99 Issue 2</td>
      <td>Issue 2 (consolidating Amendment 1, February 2024)</td>
      <td>10 March 2025</td>
      <td>Connection of generating plant, including energy storage, to the DNO distribution networks.</td>
    </tr>
    <tr>
      <td>ENA EREC G99 Issue 2 Annex C</td>
      <td>Issue 2, Annex C</td>
      <td>1 March 2026</td>
      <td>Storage-specific provisions (applicable only if BESS).</td>
    </tr>
    <tr>
      <td>ENA EREC G5/5 Issue 1</td>
      <td>Issue 1 (2020)</td>
      <td>2020</td>
      <td>Harmonic voltage distortion limits on distribution networks.</td>
    </tr>
    <tr>
      <td>ENA EREC P28 Issue 2</td>
      <td>Issue 2 (2019)</td>
      <td>2019</td>
      <td>Flicker Pst / Plt planning limits and voltage step-change limits.</td>
    </tr>
    <tr>
      <td>ENA EREC P29 Issue 1</td>
      <td>Issue 1 (2019)</td>
      <td>2019</td>
      <td>Voltage unbalance planning limits.</td>
    </tr>
    <tr>
      <td>IEC 61869-2</td>
      <td>Ed. 1.0</td>
      <td>—</td>
      <td>Instrument transformers — current transformers (CT class, burden).</td>
    </tr>
    <tr>
      <td>IEC 61850-8-1 / IEC 61850-7-4</td>
      <td>Ed. 2.1 / Ed. 2.1</td>
      <td>—</td>
      <td>Substation automation — SCADA data model for Type C / D schemes.</td>
    </tr>
    <tr>
      <td>IEC 61000-4-7 / IEC 61000-4-30</td>
      <td>Ed. 2.1 / Ed. 3.0</td>
      <td>—</td>
      <td>Harmonic and power-quality measurement methods (Class A).</td>
    </tr>
    <tr>
      <td>National Electricity Transmission System Grid Code</td>
      <td>Current issue (monthly)</td>
      <td>—</td>
      <td>Applicable for Type D (≥50 MW) connections.</td>
    </tr>
    <tr>
      <td>ENA EREC G100 Issue 2</td>
      <td>Issue 2</td>
      <td>2024</td>
      <td>Export limiting scheme — applicable for schemes ≤50 kW.</td>
    </tr>
    <tr>
      <td>IEC 62443-3-3 / NCSC CAF</td>
      <td>Ed. 1.0 / v3.1</td>
      <td>—</td>
      <td>Industrial communication network security (minimum SL-2 for DNO-telecontrolled sites).</td>
    </tr>
    <tr>
      <td>NFPA 855</td>
      <td>2023</td>
      <td>—</td>
      <td>Standard for the installation of stationary energy storage systems (Annex C BESS).</td>
    </tr>
  </table>

  <h3>Princeps pre-fill provenance</h3>
  <table class="form">
    <tr><td class="lbl">Engine version</td><td>Princeps v{{ meta.princeps_version }}</td></tr>
    <tr><td class="lbl">G99 version source</td><td>{{ meta.provenance }}</td></tr>
    <tr><td class="lbl">Document reference</td><td>{{ meta.doc_ref }}</td></tr>
    <tr><td class="lbl">Generated</td><td>{{ meta.generated_at }}</td></tr>
  </table>
</section>

<footer class="doc-footer">
  Prepared by Princeps against {{ meta.ena_reference }}. G99 Issue 2
  published {{ meta.g99_published }}; Annex C (storage) effective
  {{ meta.annex_c_effective }}. All values must be verified by a qualified
  electrical engineer before submission. Princeps is not a substitute for
  professional engineering advice.
</footer>

</body>
</html>
