# =============================================================================
# Princeps Frontend — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
# =============================================================================

# --- Backend API base ---
# Absolute URL to the FastAPI backend. Leave blank to use the Vite dev proxy
# (proxies /api/* to localhost:8000).
VITE_API_BASE=http://localhost:8000

# --- Alerts / Dockets / Tracker tabs — mock vs live mode ---
# During bring-up we ship a deterministic mock corpus so the UI can be
# demoed without a live backend. Flip each to false once the matching
# backend module is healthy and returning real data.
#
# Flip priority order:
#   1. VITE_MOCK_ALERTS     — flip first, Alerts backend is furthest along
#   2. VITE_MOCK_DOCKETS    — flip once authorities + consultee rules are seeded
#   3. VITE_MOCK_TRACKER    — flip once REPD + NSIP tracker workers have run
VITE_MOCK_ALERTS=true
VITE_MOCK_DOCKETS=true
VITE_MOCK_TRACKER=true

# --- Mapbox (required for map views) ---
VITE_MAPBOX_TOKEN=pk.your_token_here

# --- Cesium ion (3D terrain + OSM Buildings — Site Designer) ---
VITE_CESIUM_ION_TOKEN=your_cesium_token_here

# --- Google Maps (Photorealistic 3D Tiles — optional) ---
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
