{
  "pipeline": [
    "inputs/*.laz",
    {
      "type": "filters.range",
      "limits": "Classification![7:7]"
    },
    {
      "type": "filters.outlier",
      "method": "statistical",
      "mean_k": 8,
      "multiplier": 2.0
    },
    {
      "type": "filters.reprojection",
      "out_srs": "EPSG:27700"
    },
    {
      "type": "writers.gdal",
      "filename": "dem.tif",
      "resolution": 2.0,
      "output_type": "mean",
      "data_type": "float32",
      "gdalopts": "COMPRESS=LZW"
    }
  ]
}
