# =============================================================================
# Princeps — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:yourpass@localhost:5432/princeps

# --- Claude AI ---
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Mapbox ---
MAPBOX_TOKEN=pk.xxx
VITE_MAPBOX_TOKEN=pk.xxx

# --- Auth ---
JWT_SECRET=change-me-to-a-random-secret

# --- SAM (PySAM subprocess bridge) ---
# Path to Python 3.11 venv with PySAM installed
SAM_PYTHON=.venv-sam/bin/python

# --- Grid (pandapower subprocess bridge) ---
# Path to Python 3.12 venv with pandapower + lightsim2grid
GRID_PYTHON=.venv-grid/bin/python

# --- Forecast (Prophet + Darts subprocess bridge) ---
# Path to Python 3.12 venv with prophet + darts + pytorch
FORECAST_PYTHON=.venv-forecast/bin/python

# --- GeeFlow (Google Earth Engine subprocess bridge) ---
# Path to Python 3.12 venv with earthengine-api
GEEFLOW_PYTHON=.venv-geeflow/bin/python
GEE_PROJECT_ID=hopeful-subject-486905-e5

# --- Neo4j (graph topology) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=princeps

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_FORMAT=text
