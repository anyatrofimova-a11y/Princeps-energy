# =============================================================================
# Princeps — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:yourpass@localhost:5432/princeps

# --- Claude AI ---
# CLAUDE_API_KEY is the canonical name; ANTHROPIC_API_KEY is accepted too.
# Required for chat, agent, and the Alerts query/stream + digest LLM paths.
CLAUDE_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI (embeddings — optional) ---
# Used by Alerts semantic search. If unset, the system falls back to
# PostgreSQL tsvector full-text search.
OPENAI_API_KEY=sk-...

# --- Mapbox ---
MAPBOX_TOKEN=pk.xxx
VITE_MAPBOX_TOKEN=pk.xxx

# --- Auth ---
JWT_SECRET=change-me-to-a-random-secret
# When true, bypass JWT / API-key checks and serve the demo user (dev only).
PRINCEPS_DEMO_MODE=true

# --- Princeps Alerts (Phase 7a) ---
# Smoke document corpus (~30 realistic UK energy docs). Lets the Alerts
# query/stream endpoint return grounded answers on a fresh DB before the
# ingestion workers have run. Leave FALSE in production.
PRINCEPS_LOAD_SMOKE_DOCS=true
# Seed the 82 alert definitions. Idempotent; safe to leave true.
PRINCEPS_SEED_ALERTS=true
# Seed the dockets authorities registry + consultee rules.
PRINCEPS_SEED_AUTHORITIES=false
# Turn on when regulatory / grid / planning ingestion credentials are set.
PRINCEPS_INGESTION_ENABLED=false
# Enterprise audit-log middleware (adds per-request DB write, low overhead).
PRINCEPS_AUDIT_ENABLED=false

# --- DNO OpenDataSoft API keys (optional, per-DNO) ---
# Dashboards degrade gracefully without these — public endpoints still work,
# but quotas are lower. Request keys from each DNO's developer portal.
UKPN_ODS_APIKEY=
SPEN_ODS_APIKEY=
SSEN_ODS_APIKEY=
ENWL_ODS_APIKEY=
NGED_ODS_APIKEY=
NPG_ODS_APIKEY=

# --- SAM (PySAM subprocess bridge) ---
# Path to Python 3.11 venv with PySAM installed
SAM_PYTHON=.venv-sam/bin/python

# --- Grid (pandapower subprocess bridge) ---
# Path to Python 3.12 venv with pandapower + lightsim2grid
GRID_PYTHON=.venv-grid/bin/python

# --- Forecast (Prophet + Darts subprocess bridge) ---
# Path to Python 3.12 venv with prophet + darts + pytorch
FORECAST_PYTHON=.venv-forecast/bin/python

# --- GeeFlow (Google Earth Engine subprocess bridge) ---
# Path to Python 3.12 venv with earthengine-api
GEEFLOW_PYTHON=.venv-geeflow/bin/python
GEE_PROJECT_ID=hopeful-subject-486905-e5

# --- Neo4j (graph topology) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=princeps

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_FORMAT=text
